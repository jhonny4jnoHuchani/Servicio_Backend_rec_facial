# python-service/.env

# Servidor
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Servicio_reconocimiento
DB_USER=postgres
DB_PASSWORD=

# ============================================
# DETECCION DE LENTES
# ============================================

# Habilitar/deshabilitar
EYEGLASS_DETECTION_ENABLED=true

# Umbral (0.0 - 1.0) - más alto = más estricto
EYEGLASS_THRESHOLD=0.7

# Tamaño del modelo: small, medium, large
EYEGLASS_MODEL_SIZE=small

# Tipo: anyglasses, sunglasses, eyeglasses
EYEGLASS_KIND=anyglasses

# Tamaño del caché
EYEGLASS_CACHE_SIZE=100

# Tiempo de vida del caché (segundos)
EYEGLASS_CACHE_TTL=5

# Timeout de predicción (segundos)
EYEGLASS_PREDICTION_TIMEOUT=1.0